# Copy to .env (git-ignored) and fill in. Used by docker compose and by the app when sourced.

# mock (no credentials) | travelpayouts (real fares, free token) | amadeus (enterprise keys only)
PRICE_PROVIDER=mock

# free token from https://www.travelpayouts.com/programs/100/tools/api
TRAVELPAYOUTS_TOKEN=

# amadeus self-service was decommissioned in July 2026; only enterprise keys still work
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# how often the scheduler checks every active watch
CHECK_INTERVAL_MINUTES=60

# upper bound for a watch's flexible-date window (days either side of your dates)
MAX_FLEX_DAYS=3

# one summary email per day instead of only per-drop alerts
DAILY_DIGEST=0
DIGEST_HOUR_UTC=7

# email alerts (Gmail: use an app password from https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
ALERT_EMAIL_FROM=you@gmail.com
ALERT_EMAIL_TO=you@gmail.com

# telegram alerts (@BotFather for the token, /getUpdates for the chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# any URL that accepts a JSON POST (Slack/Discord/Zapier incoming hooks)
ALERT_WEBHOOK_URL=
